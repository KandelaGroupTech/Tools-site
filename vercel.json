{
  "headers": [
    {
      "source": "/website-demos/excellentjob",
      "has": [
        {
          "type": "host",
          "value": "tools.thekandelagroup.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/website-demos/excellentjob/",
      "has": [
        {
          "type": "host",
          "value": "tools.thekandelagroup.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/website-demos/excellentjob/:path*",
      "has": [
        {
          "type": "host",
          "value": "tools.thekandelagroup.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    { 
      "source": "/website-demos/excellentzohocrm", 
      "destination": "https://excellentzohocrmwrap.vercel.app/website-demos/excellentzohocrm" 
    },
    { 
      "source": "/website-demos/excellentzohocrm/(.*)", 
      "destination": "https://excellentzohocrmwrap.vercel.app/website-demos/excellentzohocrm/$1" 
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
