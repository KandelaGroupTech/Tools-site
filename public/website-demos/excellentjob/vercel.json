{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/website-demos/excellentjob/:match*",
      "destination": "https://www.excellentjob.com/:match*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    }
  ]
}